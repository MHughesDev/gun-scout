# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# expo-env.d.ts is deliberately NOT ignored: `expo start` regenerates it
# locally, but CI only runs `npm ci && tsc`, and without it the ambient Expo
# types (CSS and asset imports, EXPO_PUBLIC_* env vars) don't exist and the
# typecheck fails on a project that's perfectly fine.

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
.env.local
