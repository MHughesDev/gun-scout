# Copy to .env.local for local development (git-ignored).
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time — they
# are visible to anyone with the app. Nothing secret belongs here; the backend
# holds every key the product needs (see ../render.yaml).

# Backend the app talks to. Defaults to http://localhost:8777 when unset.
#   iOS simulator      http://localhost:8777
#   Android emulator   http://10.0.2.2:8777
#   physical device    http://<your-lan-ip>:8777
EXPO_PUBLIC_API_URL=http://localhost:8777

# Set by `eas init`; only needed for EAS builds.
# EAS_PROJECT_ID=
